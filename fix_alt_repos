---
- name: Revert ALT Linux repos back to http
  hosts: all_clients
  become: yes
  gather_facts: no
  ignore_unreachable: yes

  tasks:
    - name: Find all .list files in /etc/apt/sources.list.d
      find:
        paths: /etc/apt/sources.list.d
        patterns: '*.list'
      register: list_files
      failed_when: false

    - name: Replace https://ftp.altlinux.org with http:// in .list files
      replace:
        path: "{{ item.path }}"
        regexp: 'https://ftp\.altlinux\.org'
        replace: 'http://ftp.altlinux.org'
      loop: "{{ list_files.files | default([]) }}"
      register: replace_results

    - name: Replace in /etc/apt/sources.list (if exists)
      replace:
        path: /etc/apt/sources.list
        regexp: 'https://ftp\.altlinux\.org'
        replace: 'http://ftp.altlinux.org'
      failed_when: false

    - name: Update apt cache
      apt:
        update_cache: yes
      register: apt_update
      retries: 3
      delay: 5
      until: apt_update is success
